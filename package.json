{
  "name": "@local/dsh-open-with-default",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Choose which application DSH uses by default for each file type, without changing Windows file associations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ht65/dsh-open-with-default.git"
  },
  "homepage": "https://github.com/ht65/dsh-open-with-default#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "open-with",
    "file-associations"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-native-command": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "zod": "4.6.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
